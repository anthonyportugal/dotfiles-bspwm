#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_PATH=$(realpath -m -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
if [[ -n "${BSPWM_REPO_ROOT:-}" && -d "$BSPWM_REPO_ROOT/themes" ]]; then
  REPO_ROOT="$BSPWM_REPO_ROOT"
else
  REPO_ROOT=""
  search_dir="$SCRIPT_DIR"
  while [[ "$search_dir" != "/" && -n "$search_dir" ]]; do
    if [[ -d "$search_dir/themes" && -f "$search_dir/bin/bspwm" ]]; then
      REPO_ROOT="$search_dir"
      break
    fi
    search_dir=$(dirname "$search_dir")
  done
  if [[ -z "$REPO_ROOT" ]]; then
    REPO_ROOT=$(cd -- "$SCRIPT_DIR/../../../../.." 2>/dev/null && pwd -P || echo "")
  fi
fi
THEME_ID=''
PALETTE=''
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
THEME_ROOT="$STATE_HOME/bspwm/theme"
PUBLIC_THEME_ROOT="$STATE_HOME/dotfiles/theme"
RENDER_TEMP=''

declare -A COLORS=()
declare -A EXPECTED=()

fail() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
  exit 1
}

cleanup_render() {
  if [[ -n "$RENDER_TEMP" && "$RENDER_TEMP" == "$THEME_ROOT"/.render.* && \
        -d "$RENDER_TEMP" ]]; then
    find "$RENDER_TEMP" -mindepth 1 -delete 2>/dev/null || true
    find "$RENDER_TEMP" -depth -type d -empty -delete 2>/dev/null || true
  fi
}
trap cleanup_render EXIT

usage() {
  cat <<HELP
Uso: $PROGRAM_NAME <comando> [argumentos]

Comandos:
  list              Lista todos los temas y colores de acento disponibles
  current           Muestra el tema actualmente activo
  set <id>          Compila y aplica un tema de acento Catppuccin Mocha
  menu              Abre el selector interactivo de temas con Rofi
  render [id]       Compila un tema a estado local sin activarlo
  validate [id]     Valida la sintaxis e integridad de una paleta
  path              Muestra la ruta del tema compilado activo
HELP
}

resolve_theme_id() {
  if [[ -n "${BSPWM_THEME-}" ]]; then
    printf '%s\n' "$BSPWM_THEME"
    return 0
  fi
  local selected_file="$THEME_ROOT/selected"
  if [[ -r "$selected_file" ]]; then
    local saved
    saved=$(<"$selected_file")
    if [[ -n "$saved" && -f "$REPO_ROOT/themes/$saved/palette.conf" ]]; then
      printf '%s\n' "$saved"
      return 0
    fi
  fi
  printf '%s\n' 'catppuccin-mocha-pink'
}

declare_schema() {
  local key

  for key in \
    schema id family flavour accent_name \
    rosewater flamingo pink mauve red maroon peach yellow green teal sky \
    sapphire blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0 \
    surface2 surface1 surface0 base mantle crust background background_alt \
    background_deep surface surface_hover foreground foreground_muted accent \
    urgent warning success; do
    EXPECTED["$key"]=1
  done
}

read_palette() {
  local target_id=${1:-$(resolve_theme_id)}
  THEME_ID=$target_id
  PALETTE="$REPO_ROOT/themes/$THEME_ID/palette.conf"

  local line key value

  [[ -r "$PALETTE" ]] || fail "no se puede leer la paleta: $PALETTE"
  declare_schema
  COLORS=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" && "$line" != \#* ]] || continue
    [[ "$line" == *=* ]] || fail "línea inválida en la paleta: $line"
    key=${line%%=*}
    value=${line#*=}
    [[ -v "EXPECTED[$key]" ]] || fail "clave desconocida en la paleta: $key"
    [[ ! -v "COLORS[$key]" ]] || fail "clave duplicada en la paleta: $key"
    COLORS["$key"]=$value
  done < "$PALETTE"

  for key in "${!EXPECTED[@]}"; do
    [[ -v "COLORS[$key]" ]] || fail "falta la clave de paleta: $key"
  done

  [[ "${COLORS[schema]}" == 1 ]] || fail 'schema de paleta no soportado'
  [[ "${COLORS[id]}" =~ ^[a-z0-9]+([._-][a-z0-9]+)*$ ]] || \
    fail 'id de paleta inseguro'
  [[ "${COLORS[id]}" == "$THEME_ID" ]] || fail 'el id no coincide con el tema solicitado'
  [[ "${COLORS[family]}" =~ ^[a-z0-9-]+$ ]] || fail 'familia inválida'
  [[ "${COLORS[flavour]}" =~ ^[a-z0-9-]+$ ]] || fail 'flavour inválido'
  [[ "${COLORS[accent_name]}" =~ ^[a-z0-9-]+$ ]] || fail 'accent_name inválido'

  for key in "${!COLORS[@]}"; do
    case "$key" in
      schema|id|family|flavour|accent_name)
        ;;
      *)
        [[ "${COLORS[$key]}" =~ ^#[0-9a-fA-F]{6}$ ]] || \
          fail "color inválido para $key: ${COLORS[$key]}"
        ;;
    esac
  done
}

write_lines() {
  local destination=$1
  shift
  printf '%s\n' "$@" > "$destination"
}

render_bspwm() {
  write_lines "$1/bspwm.env" \
    '# Generated by bspwm-theme. Do not edit.' \
    "BSPWM_FOCUSED_BORDER='${COLORS[accent]}'" \
    "BSPWM_ACTIVE_BORDER='${COLORS[accent]}'" \
    "BSPWM_NORMAL_BORDER='${COLORS[surface0]}'" \
    "BSPWM_PRESEL_BORDER='${COLORS[green]}'"
}

render_polybar() {
  write_lines "$1/polybar-colors.ini" \
    '; Generated by bspwm-theme. Do not edit.' \
    '[color]' \
    "BACKGROUND = ${COLORS[base]}" \
    "FOREGROUND = ${COLORS[text]}" \
    "ALTBACKGROUND = ${COLORS[surface0]}" \
    "ALTFOREGROUND = ${COLORS[subtext0]}" \
    "ACCENT = ${COLORS[accent]}" \
    '' \
    "BLACK = ${COLORS[surface1]}" \
    "RED = ${COLORS[red]}" \
    "GREEN = ${COLORS[green]}" \
    "YELLOW = ${COLORS[yellow]}" \
    "BLUE = ${COLORS[blue]}" \
    "MAGENTA = ${COLORS[accent]}" \
    "CYAN = ${COLORS[teal]}" \
    "WHITE = ${COLORS[text]}" \
    "ALTBLACK = ${COLORS[surface2]}" \
    "ALTRED = ${COLORS[maroon]}" \
    "ALTGREEN = ${COLORS[green]}" \
    "ALTYELLOW = ${COLORS[yellow]}" \
    "ALTBLUE = ${COLORS[sapphire]}" \
    "ALTMAGENTA = ${COLORS[pink]}" \
    "ALTCYAN = ${COLORS[sky]}" \
    "ALTWHITE = ${COLORS[subtext1]}"
}

render_rofi() {
  write_lines "$1/rofi-colors.rasi" \
    '/* Generated by bspwm-theme. Do not edit. */' \
    '* {' \
    "    background:     ${COLORS[base]};" \
    "    background-alt: ${COLORS[surface0]};" \
    "    foreground:     ${COLORS[text]};" \
    "    selected:       ${COLORS[accent]};" \
    "    active:         ${COLORS[green]};" \
    "    urgent:         ${COLORS[urgent]};" \
    '}'
}

render_dunst() {
  write_lines "$1/dunstrc" \
    '# Generated by bspwm-theme. Do not edit.' \
    '[global]' \
    '    follow = keyboard' \
    '    width = (280, 420)' \
    '    height = (0, 300)' \
    '    origin = top-right' \
    '    offset = (12, 42)' \
    '    notification_limit = 8' \
    '    progress_bar = true' \
    '    progress_bar_height = 8' \
    '    progress_bar_frame_width = 1' \
    '    progress_bar_min_width = 180' \
    '    progress_bar_max_width = 360' \
    '    indicate_hidden = yes' \
    '    transparency = 4' \
    '    separator_height = 2' \
    '    padding = 10' \
    '    horizontal_padding = 12' \
    '    text_icon_padding = 10' \
    '    frame_width = 2' \
    "    frame_color = \"${COLORS[accent]}\"" \
    '    separator_color = frame' \
    "    highlight = \"${COLORS[accent]}\"" \
    '    gap_size = 6' \
    '    font = JetBrains Mono 9' \
    '    line_height = 2' \
    '    markup = full' \
    '    format = "<b>%s</b>\n%b"' \
    '    alignment = left' \
    '    vertical_alignment = center' \
    '    ellipsize = middle' \
    '    stack_duplicates = true' \
    '    hide_duplicate_count = false' \
    '    show_indicators = yes' \
    '    icon_position = left' \
    '    min_icon_size = 24' \
    '    max_icon_size = 48' \
    '    corner_radius = 8' \
    '    mouse_left_click = close_current' \
    '    mouse_middle_click = do_action, close_current' \
    '    mouse_right_click = close_all' \
    '' \
    '[urgency_low]' \
    "    background = \"${COLORS[base]}\"" \
    "    foreground = \"${COLORS[subtext0]}\"" \
    '    timeout = 5' \
    '' \
    '[urgency_normal]' \
    "    background = \"${COLORS[base]}\"" \
    "    foreground = \"${COLORS[text]}\"" \
    '    timeout = 8' \
    '' \
    '[urgency_critical]' \
    "    background = \"${COLORS[base]}\"" \
    "    foreground = \"${COLORS[urgent]}\"" \
    "    frame_color = \"${COLORS[urgent]}\"" \
    '    timeout = 0'
}

render_gtk() {
  write_lines "$1/gtk.css" \
    '/* Generated by bspwm-theme. Do not edit. */' \
    "@define-color accent_color ${COLORS[accent]};" \
    "@define-color accent_bg_color ${COLORS[accent]};" \
    "@define-color accent_fg_color ${COLORS[background_deep]};"
}

render_yazi() {
  local destination=$1
  local template="$REPO_ROOT/themes/templates/yazi-flavor.toml"
  mkdir -p "$destination/yazi"
  if [[ -f "$template" ]]; then
    sed "s/{{accent}}/${COLORS[accent]}/g" "$template" > "$destination/yazi/flavor.toml"
  fi
}

render_all() {
  local destination=$1

  mkdir -p -- "$destination"
  render_bspwm "$destination"
  render_polybar "$destination"
  render_rofi "$destination"
  render_dunst "$destination"
  render_gtk "$destination"
  render_yazi "$destination"
  write_lines "$destination/background" "${COLORS[background]}"
  write_lines "$destination/metadata" \
    'schema=1' \
    "id=${COLORS[id]}" \
    "family=${COLORS[family]}" \
    "flavour=${COLORS[flavour]}" \
    "accent_name=${COLORS[accent_name]}"
}

validate_outputs() {
  local destination=$1
  local required

  for required in bspwm.env polybar-colors.ini rofi-colors.rasi dunstrc \
    gtk.css yazi/flavor.toml background metadata; do
    [[ -s "$destination/$required" ]] || fail "output de tema vacío o ausente: $required"
  done
  grep -Fq "${COLORS[accent]}" "$destination/polybar-colors.ini" || \
    fail 'Polybar no recibió el acento del tema'
  grep -Fq "${COLORS[accent]}" "$destination/rofi-colors.rasi" || \
    fail 'Rofi no recibió el acento del tema'
  grep -Fq "${COLORS[accent]}" "$destination/dunstrc" || \
    fail 'Dunst no recibió el acento del tema'
  grep -Fxq "id=${COLORS[id]}" "$destination/metadata" || \
    fail 'metadata de tema inconsistente'
}

promote() {
  local revision=$1
  local next_link="$THEME_ROOT/.current.$$"

  ln -s -- "$revision" "$next_link"
  mv -Tf -- "$next_link" "$THEME_ROOT/current"

  mkdir -p -- "$PUBLIC_THEME_ROOT"
  local public_next="$PUBLIC_THEME_ROOT/.current.$$"
  ln -s -- "../../bspwm/theme/current" "$public_next"
  mv -Tf -- "$public_next" "$PUBLIC_THEME_ROOT/current"

  local config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
  local yazi_flavor_link="$config_home/yazi/flavors/theme.yazi"
  if [[ -d "$config_home/yazi" ]]; then
    mkdir -p "${yazi_flavor_link%/*}"
    ln -sfn "$PUBLIC_THEME_ROOT/current/yazi" "$yazi_flavor_link"
  fi
}

render_theme() {
  local digest revision

  mkdir -p -- "$THEME_ROOT"
  command -v flock >/dev/null 2>&1 || fail 'flock es necesario para renderizar temas'
  exec 9>"$THEME_ROOT/render.guard"
  flock 9
  local template="$REPO_ROOT/themes/templates/yazi-flavor.toml"
  if [[ -f "$template" ]]; then
    digest=$(sha256sum -- "$PALETTE" "$SCRIPT_PATH" "$template" | sha256sum)
  else
    digest=$(sha256sum -- "$PALETTE" "$SCRIPT_PATH" | sha256sum)
  fi
  digest=${digest%% *}
  revision="${COLORS[id]}-${digest:0:12}"

  if [[ ! -d "$THEME_ROOT/$revision" ]]; then
    RENDER_TEMP=$(mktemp -d "$THEME_ROOT/.render.XXXXXX")
    render_all "$RENDER_TEMP"
    validate_outputs "$RENDER_TEMP"
    chmod -R u=rwX,go=rX -- "$RENDER_TEMP"
    mv -- "$RENDER_TEMP" "$THEME_ROOT/$revision"
    RENDER_TEMP=''
  else
    validate_outputs "$THEME_ROOT/$revision"
  fi

  promote "$revision"
  printf '%s\n' "$THEME_ROOT/$revision"
}

reload_live() {
  # 1. Update live bspwm border colors
  if command -v bspc >/dev/null 2>&1; then
    bspc config focused_border_color "${COLORS[accent]}" 2>/dev/null || true
    bspc config active_border_color "${COLORS[accent]}" 2>/dev/null || true
    bspc config normal_border_color "${COLORS[surface0]}" 2>/dev/null || true
    bspc config presel_feedback_color "${COLORS[green]}" 2>/dev/null || true
  fi

  # 2. Reload Polybar with new colors
  local bspwm_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm"
  if [[ -x "$bspwm_dir/scripts/launch-polybar" ]] && pgrep -u "$UID" -x polybar >/dev/null 2>&1; then
    "$bspwm_dir/scripts/launch-polybar" >/dev/null 2>&1 &
  fi

  # 3. Reload Dunst with new colors
  if pgrep -u "$UID" -x dunst >/dev/null 2>&1; then
    pkill -TERM -u "$UID" -x dunst 2>/dev/null || true
    if command -v dunst >/dev/null 2>&1 && [[ -r "$THEME_ROOT/current/dunstrc" ]]; then
      dunst --config "$THEME_ROOT/current/dunstrc" >/dev/null 2>&1 &
    fi
  fi

  # 4. Modern GTK4 / Libadwaita accent color sync
  if command -v gsettings >/dev/null 2>&1; then
    local gnome_accent
    case "${COLORS[accent_name]}" in
      blue|sapphire) gnome_accent=blue ;;
      teal|sky)      gnome_accent=teal ;;
      green)         gnome_accent=green ;;
      yellow)        gnome_accent=yellow ;;
      peach)         gnome_accent=orange ;;
      red|maroon)    gnome_accent=red ;;
      pink|flamingo) gnome_accent=pink ;;
      mauve|lavender) gnome_accent=purple ;;
      *)             gnome_accent=slate ;;
    esac
    gsettings set org.gnome.desktop.interface accent-color "$gnome_accent" 2>/dev/null || true
  fi
}

set_theme() {
  local target_id=$1
  [[ -f "$REPO_ROOT/themes/$target_id/palette.conf" ]] || fail "tema desconocido: $target_id"

  mkdir -p -- "$THEME_ROOT"
  printf '%s\n' "$target_id" > "$THEME_ROOT/selected"
  read_palette "$target_id"
  local rendered_path
  rendered_path=$(render_theme)

  reload_live

  if command -v notify-send >/dev/null 2>&1; then
    notify-send --urgency=low --app-name=bspwm \
      "Tema aplicado" \
      "$target_id (${COLORS[accent_name]}: ${COLORS[accent]})"
  fi
  printf '%s\n' "$rendered_path"
}

list_themes() {
  local dir
  for dir in "$REPO_ROOT/themes"/*/; do
    [[ -f "$dir/palette.conf" ]] || continue
    basename "$dir"
  done | sort
}

current_theme() {
  local active_id
  active_id=$(resolve_theme_id)
  read_palette "$active_id"
  printf '%s (acento: %s, %s)\n' "$THEME_ID" "${COLORS[accent_name]}" "${COLORS[accent]}"
}

theme_menu() {
  local theme_dir
  theme_dir="$THEME_ROOT/current"
  [[ -d "$theme_dir" ]] || {
    render_theme >/dev/null
    theme_dir="$THEME_ROOT/current"
  }

  local options=(
    "🌸  Pink      (catppuccin-mocha-pink)      #f5c2e7"
    "🟣  Mauve     (catppuccin-mocha-mauve)     #cba6f7"
    "🪻  Lavender  (catppuccin-mocha-lavender)  #b4befe"
    "🔵  Blue      (catppuccin-mocha-blue)      #89b4fa"
    "🔷  Sapphire  (catppuccin-mocha-sapphire)  #74c7ec"
    "🩵  Sky       (catppuccin-mocha-sky)       #89dceb"
    "🌊  Teal      (catppuccin-mocha-teal)      #94e2d5"
    "🟢  Green     (catppuccin-mocha-green)     #a6e3a1"
    "🟡  Yellow    (catppuccin-mocha-yellow)    #f9e2af"
    "🍑  Peach     (catppuccin-mocha-peach)     #fab387"
    "🌺  Maroon    (catppuccin-mocha-maroon)    #eba0ac"
    "🔴  Red       (catppuccin-mocha-red)       #f38ba8"
    "🦩  Flamingo  (catppuccin-mocha-flamingo)  #f2cdcd"
    "🌹  Rosewater (catppuccin-mocha-rosewater) #f5e0dc"
  )

  command -v rofi >/dev/null 2>&1 || fail "rofi es necesario para abrir el menú interactivo"

  local rofi_dir="${XDG_CONFIG_HOME:-$HOME/.config}/bspwm/themes/catppuccin/rofi"
  local -a rofi_args=(
    -dmenu
    -i
    -p "Tema ❯"
    -mesg "Selecciona un color de acento Catppuccin Mocha"
    -theme "$rofi_dir/launcher.rasi"
    -theme-str 'configuration { show-icons: false; } window { width: 520px; } listview { lines: 14; } element-icon { enabled: false; }'
  )

  local choice
  choice=$(printf '%s\n' "${options[@]}" | rofi "${rofi_args[@]}" || true)

  [[ -n "$choice" ]] || return 0

  if [[ "$choice" =~ \((catppuccin-mocha-[a-z]+)\) ]]; then
    set_theme "${BASH_REMATCH[1]}"
  fi
}

main() {
  local command_name=${1:-help}
  shift || true

  case "$command_name" in
    list)
      list_themes
      ;;
    current)
      current_theme
      ;;
    set)
      (( $# > 0 )) || fail "se necesita el identificador del tema"
      set_theme "$1"
      ;;
    menu)
      theme_menu
      ;;
    render)
      local requested_id=${1:-$(resolve_theme_id)}
      read_palette "$requested_id"
      render_theme
      ;;
    validate)
      local target_id=${1:-$(resolve_theme_id)}
      read_palette "$target_id"
      printf 'OK: paleta válida para %s (%s)\n' "$THEME_ID" "${COLORS[accent_name]}"
      ;;
    path)
      local current_path="$THEME_ROOT/current"
      if [[ -d "$current_path" ]]; then
        realpath -m -- "$current_path"
      else
        render_theme
      fi
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      fail "comando desconocido: $command_name"
      ;;
  esac
}

main "$@"
