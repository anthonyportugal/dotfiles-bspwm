#!/usr/bin/env bash

set -Eeuo pipefail

command -v wpctl >/dev/null 2>&1 || {
  printf 'bspwm-volume: wpctl no está instalado\n' >&2
  exit 127
}

action="${1-}"

case "$action" in
  up)
    wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    ;;
  down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    ;;
  mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
  mic-mute)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    ;;
  *)
    printf 'Uso: %s up|down|mute|mic-mute\n' "${0##*/}" >&2
    exit 2
    ;;
esac

command -v notify-send >/dev/null 2>&1 || exit 0

if [[ "$action" == "mic-mute" ]]; then
  status=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)
  if grep -q 'MUTED' <<< "$status"; then
    notify-send -h string:x-dunst-stack-tag:bspwm-mic "Micrófono" "󰍭 Silenciado"
  else
    notify-send -h string:x-dunst-stack-tag:bspwm-mic "Micrófono" "󰍬 Activo"
  fi
else
  status=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
  if grep -q 'MUTED' <<< "$status"; then
    notify-send -h string:x-dunst-stack-tag:bspwm-volume "Volumen" "󰝟 Silenciado"
  else
    vol=$(awk '{print int(($2 * 100) + 0.5)}' <<< "$status")
    vol=${vol:-0}
    if (( vol < 33 )); then
      icon="󰕿"
    elif (( vol < 66 )); then
      icon="󰖀"
    else
      icon="󰕾"
    fi
    notify-send -h string:x-dunst-stack-tag:bspwm-volume -h "int:value:$vol" "Volumen: ${vol}%" "$icon"
  fi
fi
